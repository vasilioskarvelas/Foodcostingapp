{
  "name": "EmailReportSchedule",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "report_type": {
      "type": "string"
    },
    "recipients": {
      "type": "string"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "weekly",
        "monthly"
      ],
      "default": "weekly"
    },
    "day_of_week": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "last_sent": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": true,
    "delete": true
  }
}